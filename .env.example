# Local mode uses SQLite and stores data under the work directory.
DATABASE_URL=sqlite:///./data/workbench.db
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=26214400
RAG_MODE=mock
VITE_API_BASE_URL=/api/v1
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:4173

# Local-only Compose defaults. Change these before sharing the Compose file.
POSTGRES_DB=rag_workbench
POSTGRES_USER=rag_workbench
POSTGRES_PASSWORD=rag_workbench_local_only
COMPOSE_DATABASE_URL=postgresql+psycopg://rag_workbench:rag_workbench_local_only@postgres:5432/rag_workbench
COMPOSE_WEB_ORIGINS=http://localhost:4173
